{
  "name": "nexus-market-tests",
  "version": "1.0.0",
  "description": "Tests E2E Playwright pour NEXUS Market",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:install": "playwright install chromium",
    "build": "echo Static site",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/assets/tailwind.build.css --minify",
    "lint": "eslint \"functions/**/*.js\" \"tests/**/*.js\"",
    "precommit": "npm run lint && npm run test:unit",
    "format": "prettier --write \"functions/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"tests/**/*.js\"",
    "push": "node push.js",
    "deploy": "node push.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "libphonenumber-js": "^1.13.8"
  }
}
