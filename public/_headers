# Cloudflare Pages — Custom Headers
# Documentation : https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(self), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP en mode BLOQUANT (enforce) depuis 2026-08-02. Surensemble strict de l'ancienne
  # policy Report-Only (rien retiré → tout ce qui passait continue de passer) + ajout des
  # endpoints connect-src/frame-src que les flux dynamiques utilisent réellement au runtime
  # et qui n'apparaissaient pas dans le grep statique : Google Analytics (collect),
  # segments HLS Mux (stream.mux.com via fetch, pas seulement media-src) + télémétrie Mux
  # (litix.io), EmailJS, OAuth Google (accounts/oauth2), télémétrie Stripe (m.stripe.*),
  # 3DS Stripe (hooks.stripe.com en frame). 'unsafe-inline'/'unsafe-eval' conservés
  # (front monolithique inline — pas de nonce/hash réaliste à court terme).
  # ⚠️ Rollback immédiat en cas de casse d'un flux : renommer cette directive en
  # « Content-Security-Policy-Report-Only » (redéploiement Cloudflare) → redevient inoffensive.
  # [FIX 2026-08-27] worker-src absent → fallback implicite sur script-src, qui n'autorise
  # pas le schéma blob: → tout Worker(blob:...) créé par une lib tierce (Sentry, GA, etc.)
  # était bloqué en boucle sur toutes les pages. Ajout explicite de worker-src.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://js.stripe.com https://pagead2.googlesyndication.com https://www.googletagmanager.com https://connect.facebook.net https://plausible.io https://accounts.google.com https://browser.sentry-cdn.com https://static.cloudflareinsights.com https://esm.sh; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://stream.mux.com https://image.mux.com https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.green-api.com https://*.api.greenapi.com https://api.cloudinary.com https://api.brevo.com https://plausible.io https://js.stripe.com https://api.stripe.com https://m.stripe.com https://m.stripe.network https://paytech.sn https://dashboard.paytech.sn https://pagead2.googlesyndication.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://stream.mux.com https://*.litix.io https://api.emailjs.com https://accounts.google.com https://oauth2.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://cloudflareinsights.com; frame-src https://js.stripe.com https://hooks.stripe.com https://www.facebook.com https://accounts.google.com https://pagead2.googlesyndication.com https://stream.mux.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://ep2.adtrafficquality.google; form-action 'self'

# Service worker doit pouvoir contrôler tout le scope
/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Cache long pour les assets statiques
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pas de cache pour les fonctions API
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

# APK Android en téléchargement direct (app pas encore sur le Play Store).
# Content-Disposition force un vrai téléchargement de fichier (pas d'affichage
# inline) ; Cache-Control modéré (pas "immutable" : le fichier sera remplacé à
# chaque nouvelle version de l'app, sans changer de nom — revalidation sous 1h).
/downloads/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

